local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer

-- STATES
local chamsEnabled = false
local outlineEnabled = false
local healthEnabled = false
local teamCheck = false
local guiVisible = true

local espCache = {}
local healthCache = {}

-- GUI
local gui = Instance.new("ScreenGui", player.PlayerGui)
gui.ResetOnSpawn = false

local main = Instance.new("Frame", gui)
main.Size = UDim2.new(0,300,0,300)
main.Position = UDim2.new(0.5,-150,0.5,-150)
main.BackgroundColor3 = Color3.fromRGB(20,20,20)
Instance.new("UICorner", main).CornerRadius = UDim.new(0,12)

local top = Instance.new("Frame", main)
top.Size = UDim2.new(1,0,0,35)
top.BackgroundColor3 = Color3.fromRGB(30,30,30)
Instance.new("UICorner", top).CornerRadius = UDim.new(0,12)

local title = Instance.new("TextLabel", top)
title.Size = UDim2.new(1,0,1,0)
title.BackgroundTransparency = 1
title.Text = "ScriptWar2e"
title.TextColor3 = Color3.new(1,1,1)
title.Font = Enum.Font.GothamBold
title.TextSize = 16

-- BUTTON CREATOR
local function btn(text, y)
	local b = Instance.new("TextButton", main)
	b.Size = UDim2.new(1,-20,0,40)
	b.Position = UDim2.new(0,10,0,y)
	b.BackgroundColor3 = Color3.fromRGB(40,40,40)
	b.Text = text
	b.TextColor3 = Color3.new(1,1,1)
	b.Font = Enum.Font.Gotham
	b.TextSize = 14
	Instance.new("UICorner", b).CornerRadius = UDim.new(0,8)
	return b
end

local chamsBtn = btn("Chams ESP: OFF", 50)
local outlineBtn = btn("Outline ESP: OFF", 100)
local healthBtn = btn("Health Bar: OFF", 150)
local teamBtn = btn("Apply Team Check", 200)

-- DRAG
local dragging, dragInput, mousePos, framePos = false
top.InputBegan:Connect(function(i)
	if i.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = true
		mousePos = i.Position
		framePos = main.Position
		i.Changed:Connect(function()
			if i.UserInputState == Enum.UserInputState.End then dragging = false end
		end)
	end
end)

top.InputChanged:Connect(function(i)
	if i.UserInputType == Enum.UserInputType.MouseMovement then dragInput = i end
end)

UIS.InputChanged:Connect(function(i)
	if i == dragInput and dragging then
		local delta = i.Position - mousePos
		main.Position = UDim2.new(framePos.X.Scale, framePos.X.Offset + delta.X, framePos.Y.Scale, framePos.Y.Offset + delta.Y)
	end
end)

-- KEYBIND (K TO TOGGLE GUI)
UIS.InputBegan:Connect(function(input, gpe)
	if gpe then return end
	if input.KeyCode == Enum.KeyCode.K then
		guiVisible = not guiVisible
		main.Visible = guiVisible
	end
end)

-- TEAM CHECK
local function isEnemy(p)
	if not teamCheck then return true end
	return p.Team ~= player.Team
end

-- ESP CREATE
local function getHighlight(char)
	if not espCache[char] then
		local hl = Instance.new("Highlight")
		hl.Name = "ESP"
		hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		hl.Parent = char
		espCache[char] = hl
	end
	return espCache[char]
end

-- HEALTH BAR CREATE (SMALLER)
local function getHealth(plr)
	if not healthCache[plr] then
		local bill = Instance.new("BillboardGui")
		bill.Size = UDim2.new(0,4,0,35) -- smaller
		bill.AlwaysOnTop = true

		local bg = Instance.new("Frame", bill)
		bg.Size = UDim2.new(1,0,1,0)
		bg.BackgroundColor3 = Color3.fromRGB(30,30,30)
		Instance.new("UICorner", bg).CornerRadius = UDim.new(1,0)

		local bar = Instance.new("Frame", bg)
		bar.Size = UDim2.new(1,0,1,0)
		Instance.new("UICorner", bar).CornerRadius = UDim.new(1,0)

		healthCache[plr] = {gui = bill, bar = bar}
	end
	return healthCache[plr]
end

-- UPDATE LOOP (NO FLICKER)
RunService.RenderStepped:Connect(function()
	for _, p in pairs(Players:GetPlayers()) do
		if p ~= player and p.Character and isEnemy(p) then
			local char = p.Character

			-- ESP
			if chamsEnabled or outlineEnabled then
				local hl = getHighlight(char)

				if chamsEnabled then
					hl.FillColor = Color3.fromRGB(255,0,0)
					hl.FillTransparency = 0.5
					hl.OutlineColor = Color3.fromRGB(255,255,255)
					hl.OutlineTransparency = 0
				elseif outlineEnabled then
					hl.FillTransparency = 1
					hl.OutlineColor = Color3.fromRGB(255,0,0)
					hl.OutlineTransparency = 0
				end
			else
				if espCache[char] then
					espCache[char]:Destroy()
					espCache[char] = nil
				end
			end

			-- HEALTH BAR (LEFT, SMALL)
			if healthEnabled then
				local hum = char:FindFirstChild("Humanoid")
				local root = char:FindFirstChild("HumanoidRootPart")
				if hum and root then
					local data = getHealth(p)
					data.gui.Parent = root
					data.gui.StudsOffset = Vector3.new(-2, 1.4, 0)

					local hp = hum.Health / hum.MaxHealth
					data.bar.Size = UDim2.new(1,0,hp,0)

					if hum.Health > 70 then
						data.bar.BackgroundColor3 = Color3.fromRGB(0,255,0)
					elseif hum.Health > 30 then
						data.bar.BackgroundColor3 = Color3.fromRGB(255,255,0)
					else
						data.bar.BackgroundColor3 = Color3.fromRGB(255,0,0)
					end
				end
			else
				if healthCache[p] then
					healthCache[p].gui:Destroy()
					healthCache[p] = nil
				end
			end
		end
	end
end)

-- BUTTONS
chamsBtn.MouseButton1Click:Connect(function()
	chamsEnabled = not chamsEnabled
	chamsBtn.Text = "Chams ESP: " .. (chamsEnabled and "ON" or "OFF")
end)

outlineBtn.MouseButton1Click:Connect(function()
	outlineEnabled = not outlineEnabled
	outlineBtn.Text = "Outline ESP: " .. (outlineEnabled and "ON" or "OFF")
end)

healthBtn.MouseButton1Click:Connect(function()
	healthEnabled = not healthEnabled
	healthBtn.Text = "Health Bar: " .. (healthEnabled and "ON" or "OFF")
end)

teamBtn.MouseButton1Click:Connect(function()
	teamCheck = true
end)
