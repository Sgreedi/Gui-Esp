end)

nameBtn.MouseButton1Click:Connect(function()
	nameOn = not nameOn
	nameBtn.Text = "Name ESP: " .. (nameOn and "ON" or "OFF")
end)

headDotBtn.MouseButton1Click:Connect(function()
	headDotOn = not headDotOn
	headDotBtn.Text = "Head Dot: " .. (headDotOn and "ON" or "OFF")
end)

healthBtn.MouseButton1Click:Connect(function()
